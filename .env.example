# AI Search Optimization Agent Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED: Google API Key for Gemini
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
AI_SEARCH_GOOGLE_API_KEY=your-google-api-key-here

# ===========================================
# OPTIONAL: Model Configuration
# ===========================================
# Gemini model to use (default: gemini-1.5-pro)
# Options: gemini-1.5-pro, gemini-1.5-flash, gemini-pro
AI_SEARCH_GEMINI_MODEL=gemini-1.5-pro

# Temperature for LLM responses (0.0 - 1.0)
# Lower = more focused, Higher = more creative
AI_SEARCH_GEMINI_TEMPERATURE=0.7

# Maximum tokens for responses
AI_SEARCH_GEMINI_MAX_TOKENS=4096

# ===========================================
# OPTIONAL: Search API (for live search results)
# ===========================================
# SerpAPI key for search results
# Get your key from: https://serpapi.com/
AI_SEARCH_SERPAPI_KEY=

# ===========================================
# OPTIONAL: Agent Configuration
# ===========================================
# Maximum iterations for agent loops
AI_SEARCH_MAX_ITERATIONS=10

# Enable verbose logging
AI_SEARCH_VERBOSE=true

# ===========================================
# OPTIONAL: Caching Configuration
# ===========================================
# Enable response caching
AI_SEARCH_CACHE_ENABLED=true

# Cache time-to-live in seconds (default: 1 hour)
AI_SEARCH_CACHE_TTL=3600

# Cache directory path
AI_SEARCH_CACHE_DIR=.cache/ai_search_optimizer

# ===========================================
# OPTIONAL: Rate Limiting
# ===========================================
# Requests per minute limit
AI_SEARCH_REQUESTS_PER_MINUTE=60

# ===========================================
# OPTIONAL: Content Analysis
# ===========================================
# Minimum content length for analysis
AI_SEARCH_MIN_CONTENT_LENGTH=100

# Maximum keywords to extract
AI_SEARCH_MAX_KEYWORDS=20
